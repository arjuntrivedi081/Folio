rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isValidUpload() {
      return request.resource.size <= 25 * 1024 * 1024 // 25 MB cap
        && (
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('image/png') ||
          request.resource.contentType.matches('image/jpeg') ||
          request.resource.contentType.matches('image/webp')
        );
    }

    // Public read on resources/** for preview and download URLs
    // Write validated for PDF, PNG, JPG, JPEG, and WEBP under 25 MB; Delete allowed
    match /resources/{allPaths=**} {
      allow read: if true;
      allow write: if isValidUpload();
      allow delete: if true;
    }
  }
}
